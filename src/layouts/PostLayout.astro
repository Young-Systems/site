---
import BaseLayout from './BaseLayout.astro';
import { formatEasternDateTime } from '../utils/dates';
const { title, description, publishedAt, updatedAt, tags = [], references = [], headings = [] } = Astro.props;
const sections = headings.filter((heading: { depth: number }) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={`${title} — Young Systems`} description={description}>
  <article class:list={["post", { "post-with-navigation": sections.length > 0 }]}>
    <header class="post-header">
      <a class="back-link" href="/blog">← All articles</a>
      <p class="eyebrow">Article</p>
      <h1>{title}</h1>
      <p class="post-dek">{description}</p>
      <div class="post-details">
        <time datetime={publishedAt.toISOString()}>{formatEasternDateTime(publishedAt, 'long')}</time>
        {updatedAt && <span>Updated {formatEasternDateTime(updatedAt, 'long')}</span>}
        <span>{Math.max(1, Math.round(Astro.props.words / 220))} min read</span>
      </div>
      <ul class="tag-list">{tags.map((tag: string) => <li>{tag}</li>)}</ul>
      {references.length > 0 && (
        <aside class="post-references" aria-labelledby="post-references-title">
          <h2 id="post-references-title">References</h2>
          <ul>
            {references.map((reference: { label: string; url: string; type?: string }) => (
              <li>
                {reference.type && <span>{reference.type}</span>}
                <a href={reference.url} target="_blank" rel="noreferrer">
                  {reference.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
      <div class="share-area">
        <button class="share-button" type="button" data-share-title={title}>
          Share article <span aria-hidden="true">↗</span>
        </button>
        <span class="share-status" role="status" aria-live="polite"></span>
      </div>
    </header>
    <div class="post-body">
      {sections.length > 0 && <aside class="post-navigation">
        <details open>
          <summary>Quick access</summary>
          <nav aria-label="Article sections">
            <ul>{sections.map((heading: { depth: number; slug: string; text: string }) => (
              <li class:list={[{ 'subsection': heading.depth === 3 }]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}</ul>
          </nav>
        </details>
      </aside>}
      <div class="prose"><slot /></div>
    </div>
  </article>
</BaseLayout>

<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-navigation a'));
  const trackedSections = sectionLinks.flatMap((link) => {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    return heading ? [{ link, heading }] : [];
  });

  if (trackedSections.length) {
    let activeLink: HTMLAnchorElement | undefined;
    let updatePending = false;

    const updateActiveSection = () => {
      updatePending = false;
      const readingLine = Math.min(window.innerHeight * 0.2, 160);
      let current = trackedSections[0];
      for (const section of trackedSections) {
        if (section.heading.getBoundingClientRect().top > readingLine) break;
        current = section;
      }
      // The last section may be too short to reach the reading line.
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = trackedSections[trackedSections.length - 1];
      }
      if (current.link === activeLink) return;
      activeLink?.removeAttribute('aria-current');
      current.link.setAttribute('aria-current', 'location');
      activeLink = current.link;
    };

    const scheduleSectionUpdate = () => {
      if (updatePending) return;
      updatePending = true;
      window.requestAnimationFrame(updateActiveSection);
    };

    window.addEventListener('scroll', scheduleSectionUpdate, { passive: true });
    window.addEventListener('resize', scheduleSectionUpdate);
    window.addEventListener('hashchange', scheduleSectionUpdate);
    window.addEventListener('load', scheduleSectionUpdate);
    // Re-evaluate positions when images or fonts change the article layout.
    const prose = document.querySelector('.prose');
    if (prose && 'ResizeObserver' in window) {
      new ResizeObserver(scheduleSectionUpdate).observe(prose);
    }
    updateActiveSection();
  }

  const shareButton = document.querySelector<HTMLButtonElement>('.share-button');
  const shareStatus = document.querySelector<HTMLElement>('.share-status');
  const sectionLinkStatus = document.createElement('span');
  sectionLinkStatus.className = 'sr-only';
  sectionLinkStatus.setAttribute('role', 'status');
  sectionLinkStatus.setAttribute('aria-live', 'polite');
  document.querySelector('.post')?.append(sectionLinkStatus);

  document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]').forEach((heading) => {
    const label = heading.textContent?.trim() ?? 'this section';
    const link = document.createElement('a');
    link.className = 'heading-link';
    link.href = `#${heading.id}`;
    link.setAttribute('aria-label', `Link to ${label}`);
    link.title = 'Link this section';
    link.textContent = '#';
    link.addEventListener('click', () => {
      if (!navigator.clipboard) return;

      void navigator.clipboard.writeText(link.href).then(() => {
        sectionLinkStatus.textContent = `Link to ${label} copied`;
        link.title = 'Section link copied';
        window.setTimeout(() => {
          link.title = 'Link this section';
          sectionLinkStatus.textContent = '';
        }, 2000);
      }).catch(() => {
        // The link still navigates to the section if clipboard access is unavailable.
      });
    });
    heading.append(link);
  });

  shareButton?.addEventListener('click', async () => {
    const title = shareButton.dataset.shareTitle ?? document.title;
    const shareData = { title, text: title, url: window.location.href };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
        if (shareStatus) shareStatus.textContent = 'Shared';
      } else {
        await navigator.clipboard.writeText(window.location.href);
        if (shareStatus) shareStatus.textContent = 'Link copied';
      }
    } catch (error) {
      if (error instanceof DOMException && error.name === 'AbortError') return;
      if (shareStatus) shareStatus.textContent = 'Unable to share';
    }
  });
</script>
