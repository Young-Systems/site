---
const path = Astro.url.pathname;
const links = [
  ['Projects', '/projects'],
  ['Thoughts', '/thoughts'],
  ['Writing', '/blog'],
  ['About', '/about'],
  ['Certifications', '/certifications'],
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Young Systems home">
    <img
      class="brand-logo"
      src="/images/brand/banner-logo.png"
      alt="Young Systems"
    />
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="sr-only">Toggle navigation</span>
    <span></span><span></span>
  </button>
  <nav id="site-nav" aria-label="Primary navigation">
    {links.map(([label, href]) => (
      <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
    ))}
    <a class="nav-contact" href="/contact">Contact</a>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>
