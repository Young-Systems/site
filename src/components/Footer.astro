---
import { isBusiness, socialLinks } from '../data/site';
---
<footer class="site-footer">
  <div>
    <a class="footer-brand" href="/">Young Systems</a>
    <p>{isBusiness ? 'Independent engineering for MSPs and businesses.' : 'Systems engineering, infrastructure, and automation.'}</p>
  </div>
  <div class="footer-links">
    <a href="https://github.com/cyber-syoung" target="_blank" rel="me noopener noreferrer">GitHub</a>
    <a href={isBusiness ? socialLinks.companyLinkedIn : socialLinks.personalLinkedIn} target="_blank" rel="noopener noreferrer">{isBusiness ? "Young Systems on LinkedIn" : "LinkedIn"}</a>
    <a href={isBusiness ? "/services#inquiry" : "/contact"}>Contact</a>
  </div>
  <p class="footer-note">Built with AI-assisted development. Articles reflect my own experience, perspectives, and technical judgment.</p>
  <p class="copyright">&copy; {new Date().getFullYear()} Young Systems</p>
</footer>
