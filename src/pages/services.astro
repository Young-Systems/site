---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicesConfig, services } from '../data/services';
const endpoint = servicesConfig.inquiryEndpoint.trim();
if (servicesConfig.acceptingProjects && endpoint && !servicesConfig.turnstileSiteKey) throw new Error('Configure PUBLIC_TURNSTILE_SITE_KEY with the inquiry endpoint.');
if (endpoint && !endpoint.startsWith('https://')) throw new Error('Project inquiry endpoint must use HTTPS.');
---
<BaseLayout title={servicesConfig.acceptingProjects ? 'Project Services & Contact | Young Systems' : 'Contact | Young Systems'} description={servicesConfig.acceptingProjects ? 'Migrations, automation, cloud, Entra ID, systems administration, integrations, and MSP tooling for MSPs and businesses.' : 'Contact Samuel Young about articles, technical collaboration, and systems engineering.'}>
  {servicesConfig.acceptingProjects ? <header class="page-header">
    <p class="eyebrow">Project services / MSPs & businesses</p>
    <h1>Engineering support.<br />From scope to handoff.</h1>
    <p>Young Systems helps MSPs expand their delivery capacity and businesses complete migrations, automation, cloud, identity, and integration projects. Work directly with an engineer, with a defined scope and a documented handoff.</p>
    <div class="actions"><a class="button primary" href="#inquiry">Discuss a project</a><a class="button" href="#partnership">MSP partnerships</a></div>
  </header> : <header class="page-header">
    <p class="eyebrow">Contact</p><h1>Let’s connect.</h1>
    <p>For questions about my articles or projects, or a conversation about systems engineering and automation, you can reach me by email.</p>
    <p class="availability-note">I am currently unavailable for new contract projects.</p>
    <div class="actions"><a class="button primary" href={`mailto:${servicesConfig.email}`}>Email Samuel Young</a><a class="button" href="/blog">Explore articles</a></div>
  </header>}
  {servicesConfig.acceptingProjects && <><section class="section" aria-labelledby="services-heading">
    <p class="eyebrow">What I offer</p><h2 id="services-heading">Practical help with a clear outcome.</h2>
    <div class="services-grid">{services.map(service => <article class="service-card"><h3>{service.title}</h3><p>{service.description}</p><p class="service-deliverables"><strong>Typical scope</strong><br />{service.deliverables}</p></article>)}</div>
  </section>
  <section id="partnership" class="section partnership-section" aria-labelledby="partnership-heading">
    <div class="section-heading"><div><p class="eyebrow">For MSP partners</p><h2 id="partnership-heading">White glove service.<br />White label delivery.</h2></div><p>Your brand, your client relationship, with Young Systems supporting delivery behind the scenes. Agree on how I represent your business before work starts, from client meetings and status updates to documentation and handoff.</p></div>
    <div class="partnership-grid">
      <article class="service-card"><h3>Represent your team</h3><p>Work under your name using agreed communication channels, escalation paths, and project processes. You stay in control of the client relationship.</p></article>
      <article class="service-card"><h3>Care for the details</h3><p>Plan changes around the client’s needs, communicate progress clearly, validate the outcome, and leave documentation in your preferred format.</p></article>
    </div>
    <p class="partnership-note">Working directly with a business? The same attention to planning, communication, and handoff applies to direct engagements.</p>
  </section>
  <section class="service-process section" aria-labelledby="process-heading">
    <div><p class="eyebrow">How we work</p><h2 id="process-heading">Agree on the work.<br />Deliver it. Hand it over.</h2><p>For MSPs, I can work within your project process and coordinate with your delivery team. For businesses, I can help translate the problem into a practical scope.</p><p>Project work is subject to availability. Timelines and cutover windows are agreed before work begins.</p></div>
    <ol><li><h3>Discovery</h3><p>Review the environment, desired outcome, dependencies, and timeline.</p></li><li><h3>Scope & delivery</h3><p>Agree on deliverables, access requirements, pricing, and validation before implementation.</p></li><li><h3>Handoff</h3><p>Document the changes, explain ongoing administration, and agree on any follow-up support.</p></li></ol>
  </section>
  </>}
  {servicesConfig.acceptingProjects && <section id="inquiry" class="inquiry-section section" aria-labelledby="inquiry-heading">
    <div><p class="eyebrow">Project inquiry</p><h2 id="inquiry-heading">What do you need help with?</h2><p>Share the goal, current environment, and timing. Please leave out passwords, access tokens, and confidential client data.</p><p>{endpoint ? 'Use this form to send your inquiry directly.' : 'This form prepares an email in your email app. Review and send it there to complete your inquiry.'}</p><p>Prefer email? <a href={`mailto:${servicesConfig.email}`}>{servicesConfig.email}</a></p></div>
    <form id="project-inquiry" data-endpoint={endpoint} data-email={servicesConfig.email} data-delivery={endpoint ? 'endpoint' : 'email'}>
      <div class="form-row"><label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label><label>Work email<input name="email" type="email" autocomplete="email" required maxlength="254" /></label></div>
      <label>Organization<input name="organization" autocomplete="organization" required maxlength="150" /></label>
      <div class="form-row"><label>Organization type<select name="organizationType" required><option value="">Select one</option><option>MSP</option><option>Small or Midsize Business</option><option>Other</option></select></label><label>Project type<select name="projectType" required><option value="">Select one</option>{services.map(service => <option>{service.title}</option>)}<option>Other / help defining scope</option></select></label></div>
      <label>Target timeline<input name="timeline" maxlength="150" placeholder="For example: cutover in November" /></label>
      <label>Project details<textarea name="details" rows="6" required minlength="20" maxlength="5000" placeholder="What outcome are you looking for? Include approximate user or device counts if relevant."></textarea></label>
      <label class="inquiry-trap" aria-hidden="true">Leave this blank<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      <label class="consent-label"><input type="checkbox" name="contactConsent" required value="yes" /><span>You may contact me about this inquiry using the information I provide.</span></label>
      {endpoint && <div class="cf-turnstile" data-sitekey={servicesConfig.turnstileSiteKey} data-action="project-inquiry" data-theme="dark" data-size="flexible"></div>}
      <button class="button primary" type="submit">{endpoint ? 'Send inquiry' : 'Prepare email inquiry'}</button>
      <p id="inquiry-status" role="status" aria-live="polite"></p>
      <noscript><p>{endpoint ? 'Enable JavaScript to use this form, or use the email link above.' : 'Please email your project details using the email link above.'}</p></noscript>
    </form>
  </section>}
  {endpoint && servicesConfig.acceptingProjects && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#project-inquiry');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    if (form.dataset.delivery === 'endpoint') {
      const status = document.querySelector('#inquiry-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!data.get('cf-turnstile-response')) {
        if (status) status.textContent = 'Complete the verification before sending.';
        return;
      }
      if (button) button.disabled = true;
      if (status) status.textContent = 'Sending your inquiry…';
      try {
        const response = await fetch(form.dataset.endpoint!, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(Object.fromEntries(data)), signal:AbortSignal.timeout(25000)});
        const result = await response.json();
        if (status) status.textContent = typeof result.message === 'string' ? result.message : 'Unable to confirm delivery. Please use the email link.';
        if (response.ok) form.reset();
      } catch {
        if (status) status.textContent = 'Unable to confirm delivery. Your message is still here. Please use the email link or try again later.';
      } finally {
        if (button) button.disabled = false;
        (window as Window & {turnstile?: {reset: () => void}}).turnstile?.reset();
      }
      return;
    }
    const labels = [['name', 'Name'], ['email', 'Email'], ['organization', 'Organization'], ['organizationType', 'Organization type'], ['projectType', 'Project type'], ['timeline', 'Timeline'], ['details', 'Details']];
    const body = labels.map(([key, label]) => `${label}: ${data.get(key) || 'Not specified'}`).join('\n\n');
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Project inquiry: ${data.get('projectType')}`)}&body=${encodeURIComponent(body)}`;
    const status = document.querySelector('#inquiry-status');
    if (status) status.textContent = 'Your email app was requested. Review and send the draft to submit your inquiry. If it did not open, use the email link beside this form.';
  });
</script>
