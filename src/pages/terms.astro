---
import BaseLayout from '../layouts/BaseLayout.astro';
import terms from '../data/terms.json';
---

<BaseLayout title="Terms and Conditions | Young Systems" description="Terms for using the Young Systems website and ordering remote business technology services, including pricing, cancellations, confidentiality, and liability.">
  <header class="page-header terms-header" id="terms-top">
    <p class="eyebrow">Young Systems</p>
    <h1>Terms and Conditions</h1>
    <p>Website use and remote business services</p>
    <div class="terms-meta">
      <p>Terms version <time datetime={terms.versionDate}>November 6, 2026</time></p>
      <button class="button" type="button" id="print-terms" hidden>Print or save as PDF</button>
    </div>
  </header>

  <div class="terms-layout">
    <aside class="terms-contents" aria-labelledby="terms-contents-title">
      <h2 id="terms-contents-title">On this page</h2>
      <ol>
        {terms.sections.map(section => (
          <li><a href={`#${section.id}`}>{section.title.replace(/^\d+ /, '')}</a></li>
        ))}
      </ol>
    </aside>
    <article class="terms-body" aria-label="Terms and Conditions">
      <p class="terms-intro">{terms.intro}</p>
      {terms.sections.map(section => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          {section.clauses.map(clause => (
            <p><strong>{clause.number}</strong>{' '}{clause.text}</p>
          ))}
        </section>
      ))}
      <a class="terms-back" href="#terms-top">Back to top</a>
    </article>
  </div>
</BaseLayout>

<script>
  const printButton = document.getElementById('print-terms');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>

<style>
  .terms-header h1 { font-size: clamp(2.5rem, 5.5vw, 5rem); }
  .terms-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 1.5rem; }
  .terms-meta p { margin: 0; color: var(--muted); font-size: .88rem; }
  .terms-meta button { background: transparent; color: var(--text); font-family: inherit; cursor: pointer; }
  .terms-meta button[hidden] { display: none; }
  .terms-layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; padding-bottom: 5rem; }
  .terms-contents { position: sticky; top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto; padding-right: 1rem; }
  .terms-contents h2 { font-size: 1rem; letter-spacing: 0; line-height: 1.4; }
  .terms-contents ol { margin: 0; padding-left: 1.6rem; color: var(--muted); }
  .terms-contents li { padding: .25rem 0 .25rem .3rem; font-size: .82rem; line-height: 1.6; }
  .terms-contents a { text-decoration: none; }
  .terms-contents a:hover { color: var(--text); text-decoration: underline; }
  .terms-body { max-width: 780px; min-width: 0; }
  .terms-body p { margin: 0 0 1.25rem; line-height: 1.85; color: #c4c5ca; overflow-wrap: anywhere; }
  .terms-body strong { color: var(--text); }
  .terms-body .terms-intro { color: var(--text); padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .terms-body h2 { margin: 2.75rem 0 1.25rem; font-size: clamp(1.4rem, 2.5vw, 1.85rem); line-height: 1.3; letter-spacing: -.025em; scroll-margin-top: 2rem; }
  .terms-back { display: inline-block; margin-top: 1rem; color: var(--accent-light); }
  .terms-layout a:focus-visible, .terms-meta button:focus-visible { outline: 2px solid var(--accent-light); outline-offset: 5px; }
  @media (max-width: 850px) {
    .terms-layout { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .terms-contents { position: static; max-height: none; overflow: visible; padding: 0 0 2rem; border-bottom: 1px solid var(--line); }
    .terms-contents ol { columns: 2; column-gap: 2rem; }
    .terms-contents li { break-inside: avoid; }
  }
  @media (max-width: 520px) {
    .terms-contents ol { columns: 1; }
    .terms-header { padding-top: 3rem; }
  }
  @media print {
    :global(html) { color-scheme: light; scroll-behavior: auto; }
    :global(body), :global(.shell) { background: white !important; color: black !important; width: auto; margin: 0; }
    :global(.site-header), :global(.site-footer), :global(.skip-link), .terms-contents, .terms-meta button, .terms-back { display: none !important; }
    .terms-header { padding: 0 0 1.5rem; }
    .terms-header h1 { font-size: 26pt; }
    .terms-header :global(p), .terms-body p, .terms-body strong { color: black !important; }
    .terms-layout { display: block; padding: 0; }
    .terms-body { max-width: none; font-size: 11pt; }
    .terms-body p { line-height: 1.5; orphans: 3; widows: 3; }
    .terms-body h2 { font-size: 15pt; break-after: avoid; }
    .terms-body .terms-intro { border-color: #ccc; }
  }
</style>
