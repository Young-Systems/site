---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects — Young Systems" description="Infrastructure, Microsoft cloud, and automation projects by Samuel Young.">
  <header class="page-header"><p class="eyebrow">Projects</p><h1>Systems, scripts, and infrastructure.</h1><p>Selected work across cloud platforms, automation, networking, and the homelab.</p></header>
  <section class="section">
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
