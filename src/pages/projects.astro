---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout title="Projects — Young Systems" description="Infrastructure, Microsoft cloud, and automation projects by Samuel Young.">
  <header class="page-header"><p class="eyebrow">Projects</p><h1>Systems, scripts, and infrastructure.</h1><p>Selected work across cloud platforms, automation, networking, and the homelab.</p></header>
  <section class="section">
    <div class="grid">
      <ProjectCard title="Microsoft 365 Migration Toolkit" description="A collection of PowerShell-driven discovery, staging, validation, and remediation workflows for Microsoft 365 migration projects." tags={['PowerShell', 'Microsoft Graph', 'Exchange Online']} status="In development" />
      <ProjectCard title="Segmented Proxmox Homelab" description="Two-node virtualization environment with OPNsense routing, isolated service networks, centralized DNS, and secure remote access." tags={['Proxmox', 'OPNsense', 'VLANs', 'NetBird']} status="Operating" />
      <ProjectCard title="Cloud Edge Services" description="Public-cloud ingress and identity layer that securely connects remote clients to private services without directly exposing the homelab." tags={['Traefik', 'Authentik', 'Docker', 'OCI']} status="Operating" />
      <ProjectCard title="Infrastructure Update Automation" description="Ansible playbooks for repeatable maintenance across Linux virtual machines and containers, with platform-specific handling for Proxmox hosts." tags={['Ansible', 'Debian', 'Proxmox']} status="In development" />
      <ProjectCard title="Media Automation Platform" description="Containerized request, acquisition, organization, and playback pipeline with network isolation and shared storage." tags={['Docker Compose', 'Jellyfin', 'Linux']} status="Lab" />
      <ProjectCard title="Network Documentation Model" description="A lightweight source of truth for subnets, VLANs, endpoints, services, and dependencies—sized for a small but evolving environment." tags={['Documentation', 'IPAM', 'Architecture']} status="Design" />
    </div>
  </section>
</BaseLayout>
