---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { isPostPublished } from '../utils/posts';
import { getThoughtExcerpt } from '../utils/thoughts';
import { formatEasternDateTime, getPublicationDate } from '../utils/dates';

const posts = (await getCollection('blog', ({ data }) => isPostPublished(data)))
  .sort((a, b) => getPublicationDate(b).valueOf() - getPublicationDate(a).valueOf())
  .slice(0, 2);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const thoughts = (await getCollection('thoughts', ({ data }) => isPostPublished(data)))
  .sort((a, b) => getPublicationDate(b).valueOf() - getPublicationDate(a).valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">Samuel Young / Systems Engineer</p>
      <h1>Infrastructure that works. <span>Automation that lasts.</span></h1>
      <p class="hero-copy">Projects and notes on Microsoft cloud, infrastructure, identity, and automation.</p>
      <div class="actions">
        <a class="button primary" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
        <a class="button" href="/blog">Read field notes</a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Current focus">
      <p><strong>Focus</strong></p>
      <p>Microsoft 365 / Entra ID</p>
      <p>Infrastructure / Virtualization</p>
      <p>PowerShell / Automation</p>
      <p>Identity / Security</p>
    </aside>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Selected work</p><h2>Built from real operational problems.</h2></div>
      <p>Practical work across Microsoft cloud, networking, self-hosted infrastructure, and automation.</p>
    </div>
    <div class="grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="actions"><a class="button" href="/projects">View all projects →</a></div>
  </section>

  {thoughts.length > 0 && <section class="section quick-thoughts-section">
    <div class="section-heading">
      <div><p class="eyebrow">Quick thoughts</p><h2>Ideas that do not need a full article.</h2></div>
      <p>Short observations on technology, careers, infrastructure, and the work behind reliable systems.</p>
    </div>
    <div class="thought-feed thought-feed-preview">
      {thoughts.map((thought) => <a class="thought-feed-item" href={`/thoughts#${thought.id}`}>
        <span class="thought-avatar" aria-hidden="true">YS</span>
        <span class="thought-content">
          <span class="thought-meta"><strong>Samuel Young</strong><time datetime={getPublicationDate(thought).toISOString()}>{formatEasternDateTime(getPublicationDate(thought))}</time></span>
          <strong class="thought-title">{thought.data.title}</strong>
          <span class="thought-excerpt">{getThoughtExcerpt(thought.body)}</span>
        </span>
      </a>)}
    </div>
    <div class="actions"><a class="button" href="/thoughts">View all thoughts →</a></div>
  </section>}

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Areas of practice</p><h2>Broad infrastructure experience, applied deliberately.</h2></div>
    </div>
    <div class="expertise-list">
      <div class="expertise-item"><span class="expertise-number">01</span><div><h3>Microsoft cloud</h3><p>Microsoft 365, Exchange Online, SharePoint, OneDrive, Entra ID, and tenant migrations.</p></div></div>
      <div class="expertise-item"><span class="expertise-number">02</span><div><h3>Automation</h3><p>PowerShell, Microsoft Graph, repeatable workflows, reporting, and operational guardrails.</p></div></div>
      <div class="expertise-item"><span class="expertise-number">03</span><div><h3>Infrastructure</h3><p>Windows Server, virtualization, containers, networking, storage, and hybrid environments.</p></div></div>
      <div class="expertise-item"><span class="expertise-number">04</span><div><h3>Identity & security</h3><p>Access design, identity governance, segmentation, compliance, and practical hardening.</p></div></div>
    </div>
  </section>

  {posts.length > 0 && <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Latest writing</p><h2>Notes from the field.</h2></div>
      <p>Implementation notes and lessons learned from real systems.</p>
    </div>
    <div class="writing-list">
      {posts.map((post) => <a class="writing-item" href={`/blog/${post.id}/`}>
        <time datetime={getPublicationDate(post).toISOString()}>{formatEasternDateTime(getPublicationDate(post))}</time>
        <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>}
</BaseLayout>
