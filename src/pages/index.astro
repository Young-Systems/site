---
import { isBusiness } from '../data/site';
import { services, servicesConfig } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { isPostPublished } from '../utils/posts';
import { formatEasternDateTime, getPublicationDate } from '../utils/dates';

const posts = (await getCollection('blog', ({ data }) => isPostPublished(data)))
  .sort((a, b) => getPublicationDate(b).valueOf() - getPublicationDate(a).valueOf())
  .slice(0, 2);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">{isBusiness ? 'Young Systems / Independent systems engineering' : 'Samuel Young / Systems Engineer'}</p>
      <h1>Infrastructure that works. <span>Automation that lasts.</span></h1>
      <p class="hero-copy">{isBusiness ? 'Engineering support for MSPs and businesses. From migrations and identity to automation and integrations, Young Systems helps turn a defined scope into a working, documented solution.' : 'Projects and articles on Microsoft cloud, infrastructure, identity, and automation.'}</p>
      <div class="actions">
        <a class="button primary" href={isBusiness ? "/services#inquiry" : "/projects"}>{isBusiness ? "Discuss a project" : "Explore projects"} <span aria-hidden="true">→</span></a>
        <a class="button" href={isBusiness ? "/services" : "/blog"}>{isBusiness ? "Explore services" : "Read articles"}</a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Current focus">
      <p><strong>Focus</strong></p>
      <p>Microsoft 365 / Entra ID</p>
      <p>Infrastructure / Virtualization</p>
      <p>PowerShell / Automation</p>
      <p>Identity / Security</p>
    </aside>
  </section>

  {servicesConfig.acceptingProjects && <>
    <section class="partner-strip" aria-label="Working with Young Systems"><span>For MSPs & businesses</span><span>Defined scope</span><span>Documented delivery</span><span>Practical handoff</span></section>
    <section class="section" aria-labelledby="home-services-heading">
      <div class="section-heading"><div><p class="eyebrow">Engineering services</p><h2 id="home-services-heading">The capacity to move your next project forward.</h2></div><p>Subcontract engineering for MSP delivery teams and direct project support for businesses. Start with the outcome you need; agree on the scope, responsibilities, and timing before implementation.</p></div>
      <div class="services-grid">{services.map((service, index) => <article class="service-card"><span class="service-number">{String(index + 1).padStart(2, '0')}</span><h3>{service.title}</h3><p>{service.description}</p></article>)}</div>
      <div class="actions"><a class="button" href="/services">Service details & project inquiries →</a></div>
    </section>
    <section class="services-callout" aria-label="MSP partnerships"><div><p class="eyebrow">An extension of your delivery team</p><h2>Your client relationship. Additional engineering support.</h2><p>Coordinate delivery through your project process, agree on client communication, and hand over the documentation your team needs to support the result.</p></div><a class="button" href="/services#inquiry">Discuss a partnership</a></section>
  </>}

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Selected work</p><h2>Built from real operational problems.</h2></div>
      <p>Practical work across Microsoft cloud, networking, self-hosted infrastructure, and automation.</p>
    </div>
    <div class="grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="actions"><a class="button" href="/projects">View all projects →</a></div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Areas of practice</p><h2>Broad infrastructure experience, applied deliberately.</h2></div>
    </div>
    <div class="expertise-list">
      <div class="expertise-item"><span class="expertise-number">01</span><div><h3>Microsoft cloud</h3><p>Microsoft 365, Exchange Online, SharePoint, OneDrive, Entra ID, and tenant migrations.</p></div></div>
      <div class="expertise-item"><span class="expertise-number">02</span><div><h3>Automation</h3><p>PowerShell, Microsoft Graph, repeatable workflows, reporting, and operational guardrails.</p></div></div>
      <div class="expertise-item"><span class="expertise-number">03</span><div><h3>Infrastructure</h3><p>Windows Server, virtualization, containers, networking, storage, and hybrid environments.</p></div></div>
      <div class="expertise-item"><span class="expertise-number">04</span><div><h3>Identity & security</h3><p>Access design, identity governance, segmentation, compliance, and practical hardening.</p></div></div>
    </div>
  </section>

  {posts.length > 0 && <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Latest articles</p><h2>Guides and lessons learned.</h2></div>
      <p>Implementation notes and lessons learned from real systems.</p>
    </div>
    <div class="writing-list">
      {posts.map((post) => <a class="writing-item" href={`/blog/${post.id}/`}>
        <time datetime={getPublicationDate(post).toISOString()}>{formatEasternDateTime(getPublicationDate(post))}</time>
        <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>}
</BaseLayout>
