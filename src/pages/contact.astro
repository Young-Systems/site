---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Young Systems" description="Contact Samuel Young about systems engineering, automation, or technical collaboration.">
  <header class="page-header"><p class="eyebrow">Contact</p><h1>Let’s compare notes.</h1><p>For technical collaboration, questions about something published here, or a conversation about infrastructure and automation.</p></header>
  <section class="contact-panel">
    <div><h2>The clearest way to reach me is by email.</h2><p>Include a little context about the system, problem, or project. I read every message, but I may not be able to provide individual troubleshooting support.</p></div>
    <div class="contact-methods">
      <a href="mailto:samuel@young-systems.com"><span>Email</span><small>samuel@young-systems.com</small></a>
      <a href="https://github.com/cyber-syoung"><span>GitHub</span><small>cyber-syoung ↗</small></a>
    </div>
  </section>
  <section class="linkedin-section" aria-labelledby="linkedin-heading">
    <p class="eyebrow">Professional profile</p>
    <a
      class="linkedin-card"
      href="https://www.linkedin.com/in/cyber-syoung/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View Samuel Young on LinkedIn (opens in a new tab)"
    >
      <img src="/images/profile/samuel-young.jpg" alt="Samuel Young" width="176" height="176" />
      <div class="linkedin-card-copy">
        <span class="linkedin-label">LinkedIn</span>
        <h2 id="linkedin-heading">Samuel Young</h2>
        <p>Systems Engineer, Integrations @ NetCov - Innovation Committee Founding Member | Microsoft 365 Certified: Administrator Expert</p>
        <span class="linkedin-link">View profile <span aria-hidden="true">↗</span></span>
      </div>
    </a>
  </section>
</BaseLayout>
