{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "young-systems-project-inquiry",
  "main": "index.mjs",
  "compatibility_date": "2026-10-14",
  "vars": {
    "ALLOWED_ORIGINS": "https://young-systems.com,https://www.young-systems.com,http://localhost:4321",
    "ACCEPTING_PROJECTS": "true",
    "FROM_EMAIL": "inquiry@young-systems.com",
    "TO_EMAIL": "info@young-systems.com"
  },
  "ratelimits": [{
    "name": "INQUIRY_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": {"limit": 5, "period": 60}
  }]
}
